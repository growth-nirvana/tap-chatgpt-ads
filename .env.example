# ChatGPT Ads configuration
# Copy this file to .env and fill in your actual values

# Required: ad account-scoped Advertiser API key
TAP_CHATGPT_ADS_API_KEY=your_api_key_here

# Optional: earliest reporting date (ISO date or datetime)
TAP_CHATGPT_ADS_START_DATE=2026-01-01

# Optional: days to restate behind the bookmark (default 7)
TAP_CHATGPT_ADS_LOOKBACK_DAYS=7

# Optional: days per Insights request, maximum 365 (default 31)
TAP_CHATGPT_ADS_CHUNK_DAYS=31

# Optional: IANA timezone. Defaults to the ad account timezone.
# TAP_CHATGPT_ADS_TIMEZONE=America/New_York
